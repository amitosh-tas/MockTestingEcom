# Create test keys in the Razorpay Dashboard and copy them here.
# These values are read by the server only; never put the secret in frontend code.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
ELYSIUM_SECRET_KEY=your_elysium_secret_key
ELYSIUM_API_BASE_URL=https://api.elysium.ai
APP_URL=http://localhost:5173
PORT=5000
